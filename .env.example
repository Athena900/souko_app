NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# local/demo/trial/staging/production。Cloudflareではdemo、trialまたはproductionを明示する。
APP_ENV=local
# ローカルではデモを使う。productionではAPP_ENV=productionが優先される。
DEMO_MODE=true
# demoで永続保存を使う場合だけsupabaseを指定する。未指定はmemory。
DEMO_STORAGE=memory
# trialでは必須。ISO 8601のUTC日時をCloudflareの環境変数に設定する。
# 未設定・不正値・期限超過では、試用版の保存操作をすべて停止する。
TRIAL_END_AT=
